{{#unless continuation}}
<div class="magic-meta sheet-block">
  <div><span>{{labels.tradition}}</span><b class="pdf-field" data-pdf-field="magic.tradition">{{snapshot.magical.tradition}}</b></div>
  <div><span>{{labels.feature}}</span><b class="pdf-field" data-pdf-field="magic.feature">{{snapshot.magical.feature}}</b></div>
  <div><span>{{labels.guidevalue}}</span><b class="pdf-field" data-pdf-field="magic.guidevalue">{{snapshot.magical.guidevalue}}</b></div>
  <div><span>{{snapshot.derived.ae.abbrev}}</span><b class="pdf-field" data-pdf-field="magic.ae">{{snapshot.derived.ae.value}} / {{snapshot.derived.ae.max}}</b></div>
</div>
{{/unless}}
{{> htmlsheet-spell-table rows=rows labels=labels}}
{{#if isLast}}
<div class="trait-line sheet-block" data-split-prose><span class="trait-label">{{labels.cantrips}}</span><div class="trait-text pdf-field" data-pdf-field="magic.cantrips" data-pdf-multiline="true">{{lists.cantrips}}</div></div>
<div class="trait-line sheet-block" data-split-prose><span class="trait-label">{{labels.magicalAbilities}}</span><div class="trait-text pdf-field" data-pdf-field="magic.abilities" data-pdf-multiline="true">{{lists.magicalAbilities}}</div></div>
{{#if snapshot.traditionArtifactAbilities.length}}
<div class="trait-line sheet-block" data-split-prose><span class="trait-label">{{labels.traditionArtifactAbilities}}</span><div class="trait-text pdf-field" data-pdf-field="magic.artifactAbilities" data-pdf-multiline="true">{{lists.traditionArtifactAbilities}}</div></div>
{{/if}}
{{/if}}
