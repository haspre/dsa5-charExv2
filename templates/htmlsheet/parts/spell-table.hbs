<table class="sheet-table sheet-table-spells" data-split>
  <thead>
    <tr>
      <th class="col-name">{{labels.name}}</th>
      <th>{{labels.check}}</th>
      <th class="col-sr">{{labels.sr}}</th>
      <th>{{labels.cost}}</th>
      <th>{{labels.duration}}</th>
      <th>{{labels.range}}</th>
      <th class="col-ic">{{labels.ic}}</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows as |spell spellIndex|}}
    <tr>
      <td class="pdf-field" data-pdf-field="spell.{{@index}}.name">{{name}}</td>
      <td class="pdf-field" data-pdf-field="spell.{{@index}}.check">{{check}}</td>
      <td class="col-sr pdf-field" data-pdf-field="spell.{{@index}}.sr" data-pdf-align="center">{{sr}}</td>
      <td class="pdf-field" data-pdf-field="spell.{{@index}}.cost">{{cost}}</td>
      <td class="pdf-field" data-pdf-field="spell.{{@index}}.duration">{{castingTime}} / {{duration}}</td>
      <td class="pdf-field" data-pdf-field="spell.{{@index}}.range">{{range}}</td>
      <td class="col-ic pdf-field" data-pdf-field="spell.{{@index}}.ic" data-pdf-align="center">{{ic}}</td>
    </tr>
    <tr class="spell-effect">
      <td colspan="7">
        <div class="spell-effect-text pdf-field" data-pdf-field="spell.{{@index}}.effect" data-pdf-multiline="true">{{effect}}</div>
        {{#if extensions.length}}
        <div class="spell-extensions">
          <div class="spell-extension-heading">{{../labels.spellExtensions}}</div>
          {{#each extensions}}
          <div class="spell-extension">
            <b class="spell-extension-title pdf-field" data-pdf-field="spell.{{spellIndex}}.extension.{{@index}}.name">{{name}}</b>
            {{#if description}}<div class="spell-extension-description pdf-field" data-pdf-field="spell.{{spellIndex}}.extension.{{@index}}.description" data-pdf-multiline="true">{{description}}</div>{{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
